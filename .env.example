# ---------------------------------------------------------------------------
# IQ Motors - build-time configuration
#
# Local development: copy this file to `.env` and fill it in.
#
#   cp .env.example .env
#
# Every VITE_* value is INLINED INTO THE PUBLIC JAVASCRIPT BUNDLE at build time,
# so treat all of them as public. Never put a secret here:
#   - no Supabase service_role key
#   - no database password
#   - no private API key
# (The Supabase `anon` key is designed to be public: it is protected by Row Level
#  Security - see sql/enable_rls.sql.)
#
# The same five variables must also be set on Vercel:
#   Project -> Settings -> Environment Variables -> Production + Preview + Development
# and then REDEPLOY (Deployments -> ... -> Redeploy). Changing them does nothing to
# an existing deployment, and the Vercel build FAILS if any are missing.
# ---------------------------------------------------------------------------

# Supabase — https://supabase.com/dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-public-key>

# EmailJS — https://dashboard.emailjs.com
VITE_SERVICE_ID_EMAILJS=service_xxxxxxxx
VITE_PUBLIC_KEY_EMAILJS=xxxxxxxxxxxxxxxx
VITE_TEMPLATE_ID_EMAILJS=template_xxxxxxxx